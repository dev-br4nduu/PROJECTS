# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# --- Obrigatório para o chat com o Claude ---
# Sua chave da API Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# --- Opcionais ---
# Modelo do Claude (default: claude-3-5-sonnet-20241022)
JARVIS_MODEL=claude-3-5-sonnet-20241022

# Ambiente Flask: development (debug on) ou production
FLASK_ENV=development

# Host e porta do servidor
HOST=0.0.0.0
PORT=5000
